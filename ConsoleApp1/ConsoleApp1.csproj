    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>ConsoleApp1.CSharpPractise.RootProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="bin\Debug\net10.0\ConsoleApp1.deps.json" />
    <Content Include="bin\Debug\net10.0\ConsoleApp1.runtimeconfig.json" />
